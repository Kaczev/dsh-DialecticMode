/不入库文件
.dsh/storages/arrangements/session-73bacf78-4b5c-4c10-8d66-d79eb61d7d7f.json
/.dsh

# dialectic\ 是本机 home 的 live 预设的 junction。它**故意入库**：git 会把 junction
# 当目录走进去，于是预设内容进入版本历史——这就是备份。junction 里可能出现的杂物照旧排除：
/dialectic/node_modules/

# dialectic\ 里的这两个是 make-bundle-patch.mjs 的**生成物**，不是源。
# 源是 dialectic\agent.cordis.yml（配 preset.yml / VERSION）；重新生成：
#   $env:ELECTRON_RUN_AS_NODE=1; & "<安装目录>\DeepSeek Harness.exe" .\make-bundle-patch.mjs
/dialectic/package.json
/dialectic/cordis.patch.yml

# 仓库根的临时快照 / 草稿目录（与 Kaz 仓库同一约定；根锚定，放子目录里不会生效）
/.tmp-*/

# 仓库根的临时探针脚本，不入库
_kazcheck/
_preset-yml-check.mjs
